# 复制为 server/.env 后填写。禁止把真实密钥提交进仓库。

# 运行环境：本机开发留空（development）；服务器上填 production（wsgi.py 默认就是 production）
FLASK_CONFIG=
# 日志级别：DEBUG / INFO / WARNING / ERROR，留空为 INFO
LOG_LEVEL=
# 部署在 nginx 后面时填 1（限流需要拿到真实 IP）；本机直接运行 run.py 时留空
TRUST_PROXY=

SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=604800

DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_wardrobe

# 逗号分隔；开发可用 *
ALLOWED_ORIGINS=*

# 留空则使用 server/uploads
UPLOAD_FOLDER=

# 图片对外访问的域名前缀，如 https://api.example.com（不带结尾斜杠）。
# 留空则用当前请求的域名；上线、走反向代理或 HTTPS 时必须填写。
PUBLIC_BASE_URL=

# 微信小程序：公众平台 → 开发管理 → 开发设置 里的 AppID 和 AppSecret。用于微信一键登录
# AppSecret 只能填在 server/.env，不要提交、不要发给任何人
WX_APPID=
WX_APPSECRET=

# 和风天气：控制台 → 项目管理 → 创建凭据拿到 API KEY；设置 → 开发者信息 里查看 API Host
# API Host 形如 abc123.re.qweatherapi.com（不带 https://）
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 阿里云百炼：控制台 → API-KEY 创建。用于添加衣物时 AI 识别类型/颜色/季节/场合
DASHSCOPE_API_KEY=
# 以下两项一般不用填，留空用默认值；阿里云更新模型时可在这里换模型名
DASHSCOPE_BASE_URL=
QWEN_VL_MODEL=

# 本地抠图（rembg），一般不用填。模型首次使用时自动下载到 ~/.rembg/models/
REMBG_MODEL=
CUTOUT_MAX_SIDE=
# 掩码后处理：抹平边缘毛刺，但会把腋下、裤裆等窄缝隙填上。默认关闭，填 1 打开
CUTOUT_POST_PROCESS=
