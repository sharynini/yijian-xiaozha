# 复制为 server/.env 后填写。禁止把真实密钥提交进仓库。

SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=604800

DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_wardrobe

# 逗号分隔；开发可用 *
ALLOWED_ORIGINS=*

# 留空则使用 server/uploads
UPLOAD_FOLDER=

# 图片对外访问的域名前缀，如 https://api.example.com（不带结尾斜杠）。
# 留空则用当前请求的域名；上线、走反向代理或 HTTPS 时必须填写。
PUBLIC_BASE_URL=

# 和风天气：控制台 → 项目管理 → 创建凭据拿到 API KEY；设置 → 开发者信息 里查看 API Host
# API Host 形如 abc123.re.qweatherapi.com（不带 https://）
QWEATHER_API_KEY=
QWEATHER_API_HOST=
