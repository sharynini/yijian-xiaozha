{
  "name": "衣笺小札",
  "appid": "",
  "description": "衣笺小札：私人衣橱与穿搭手帐",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于获取当地气温，推荐适合今天天气的穿搭"
      }
    },
    "requiredPrivateInfos": ["getLocation"],
    "__usePrivacyCheck__": true
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "h5": {
    "title": "衣笺小札",
    "router": {
      "mode": "hash"
    }
  },
  "vueVersion": "3"
}
